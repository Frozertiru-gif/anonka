{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["deepseek"],
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-pro",
  "instructions": [
    "AGENTS.md",
    "ARCHITECTURE.md",
    "IMPLEMENTATION_PLAN.md"
  ],
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": {
      "*": "allow",
      ".git/**": "deny"
    },
    "bash": {
      "*": "allow",
      "git": "deny",
      "git *": "deny"
    },
    "external_directory": "deny"
  },
  "agent": {
    "deepseek": {
      "description": "Anonka coding agent. Read the project instructions before every task.",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "permission": {
        "*": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": {
          "*": "allow",
          ".git/**": "deny"
        },
        "bash": {
          "*": "allow",
          "git": "deny",
          "git *": "deny"
        },
        "external_directory": "deny"
      }
    }
  }
}
